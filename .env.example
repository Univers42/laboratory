# Laboratory -- the datacenter test bench. Copy to .env (mode 600).
#
# The lab joins the tailnet as its own device (a tailscale sidecar with a real
# tun, works under rootless Docker) and relays http://localhost:5174 to the
# platform's WAF over WireGuard. Nothing here is a password; the two keys
# are the same ones a teammate's laptop would hold.

# Reusable + ephemeral + pre-approved key, https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-...
# Extra flags for `tailscale up`, e.g. --advertise-tags=tag:lab once the ACL has tagOwners
TS_EXTRA_ARGS=
# This lab's own tailnet device name: make it machine-specific (a second
# "laboratory" gets suffixed -1, -2 by Tailscale)
LAB_NODE=laboratory-mymachine
# The node this lab drives. The address, not the MagicDNS name: the VM's name
# gains a new suffix (-5, -6...) at every rebuild while the dead ephemeral
# nodes linger in the peer list, so the name rots and the 100.x address does
# not. Shipping the name here sent a new machine to a node that no longer
# answers. The VM owner reads both back with
#   make -C born2root qemu_ssh B2B_CONFIG=profiles/server.toml CMD='tailscale status --self --peers=false'
WAF_HOST=100.85.82.107
WAF_PORT=8443

# grobase's anon key (public by design: it is what every browser client carries)
GROBASE_ANON_KEY=eyJ...
# A tenant key from `make tenant_key` in born2root, for the tenant probes (optional)
GROBASE_TENANT_KEY=
# A publish-capable realtime token from `make realtime_token` in born2root
# (REALTIME_WS_TOKEN in its secrets file). Presence and broadcast need the
# can_publish claim, which GoTrue user tokens never carry; without it those
# probes skip and say so. Scoped to the pg and lab namespaces, 30 days.
GROBASE_REALTIME_TOKEN=

# Host ports (loopback only; 5173 is QEMU's forward to the guest). 5181 serves the SAME app as a second, hostile origin
# that is deliberately absent from Kong's CORS list.
LAB_PORT=5180
LAB_API_PORT=5174
LAB_HOSTILE_PORT=5181
